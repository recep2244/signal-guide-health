# Local Pilot Environment Template
# Copy to backend/.env for local pilot runs.
# Keep this file out of version control once populated with real secrets.

NODE_ENV=development
PORT=8080

# Required security secrets (minimum 32 chars each)
# Replace with your own values for shared/team environments.
JWT_SECRET=dev_jwt_secret_change_me_1234567890
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_me_123456
COOKIE_SECRET=dev_cookie_secret_change_me_1234567
ENCRYPTION_KEY=dev_encryption_key_change_me_123456

# Local app URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local database
DATABASE_URL=postgresql://cardiowatch:password@localhost:5432/cardiowatch
DATABASE_POOL_SIZE=10

# WhatsApp Business (required for real WhatsApp pilot)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Local DeepSeek / Ollama
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=deepseek-r1:14b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=8000

# Apple + Android pilot webhook verification
APPLE_WEBHOOK_SECRET=
HEALTH_CONNECT_WEBHOOK_SECRET=

# Optional Android Google Fit OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_PUBSUB_TOKEN=

# Security feature flags
ENABLE_MFA=true
ENABLE_AUDIT_LOGGING=true
ENABLE_FIELD_ENCRYPTION=true
ADMIN_LOCAL_ONLY=false
PILOT_FOLLOWUP_SCHEDULER_ENABLED=false
PILOT_FOLLOWUP_INTERVAL_MINUTES=1440
PILOT_FOLLOWUP_BATCH_LIMIT=25
